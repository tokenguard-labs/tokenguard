# Copy to .env and fill in.
# Global (cloud) LLM: deepseek | anthropic | openai | custom (any OpenAI-compatible API) | mock
CLOUD_PROVIDER=deepseek
# Surface real cloud failures. Set to true to answer with the mock when the cloud call fails.
CLOUD_FALLBACK_TO_MOCK=false
CLOUD_MAX_TOKENS=16000
# Seconds a /health provider credential check is cached before re-pinging
CLOUD_HEALTHCHECK_TTL_S=60
# Seconds a provider /models listing is cached before re-fetching
CLOUD_MODELS_TTL_S=300
# Assumed output tokens used only for the pre-send cost estimate in /analyze
DEFAULT_OUTPUT_TOKENS_ESTIMATE=600

# DeepSeek (OpenAI-compatible). Replace the placeholder with your key from platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Custom OpenAI-compatible endpoint (Groq / OpenRouter / self-hosted). CLOUD_PROVIDER=custom
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

LOCAL_MODEL=qwen2.5-coder:1.5b
# Keep the active local model resident between prompts. Only one model is loaded at a time:
# switching models unloads the previous one first.
LOCAL_KEEP_ALIVE=30m
# Local answer length: word budget told to the model + hard token cap ("More detail" uses DETAILED)
LOCAL_BRIEF_WORDS=200
LOCAL_BRIEF_MAX_TOKENS=1200
LOCAL_DETAILED_WORDS=800
LOCAL_DETAILED_MAX_TOKENS=4000
LOCAL_THRESHOLD=0.35
CLOUD_THRESHOLD=0.65
MIN_LOCAL_CONFIDENCE=0.7
CLOUD_CONTEXT_TOKEN_BUDGET=3000
