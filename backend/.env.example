# Copy to .env and fill in.
# Global (cloud) LLM: deepseek | anthropic | openai (any OpenAI-compatible API) | mock
CLOUD_PROVIDER=deepseek
# Surface real cloud failures. Set to true to answer with the mock when the cloud call fails.
CLOUD_FALLBACK_TO_MOCK=false
CLOUD_MAX_TOKENS=16000
# Seconds a /health provider credential check is cached before re-pinging
CLOUD_HEALTHCHECK_TTL_S=60

# DeepSeek (OpenAI-compatible). Replace the placeholder with your key from platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI / Groq / OpenRouter etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

LOCAL_MODEL=qwen2.5-coder:1.5b
# Keep the active local model resident between prompts. Only one model is loaded at a time:
# switching models unloads the previous one first.
LOCAL_KEEP_ALIVE=30m
LOCAL_THRESHOLD=0.35
CLOUD_THRESHOLD=0.65
MIN_LOCAL_CONFIDENCE=0.7
CLOUD_CONTEXT_TOKEN_BUDGET=3000
