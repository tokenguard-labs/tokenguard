# Copy to .env and fill in.
# Global (cloud) LLM: deepseek | anthropic | openai | custom (any OpenAI-compatible API) | mock
CLOUD_PROVIDER=deepseek
# Surface real cloud failures. Set to true to answer with the mock when the cloud call fails.
CLOUD_FALLBACK_TO_MOCK=false
CLOUD_MAX_TOKENS=16000
# Seconds a /health provider credential check is cached before re-pinging
CLOUD_HEALTHCHECK_TTL_S=60
# Seconds a provider /models listing is cached before re-fetching
CLOUD_MODELS_TTL_S=300
# Assumed output tokens used only for the pre-send cost estimate in /analyze
DEFAULT_OUTPUT_TOKENS_ESTIMATE=600

# DeepSeek (OpenAI-compatible). Replace the placeholder with your key from platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Custom OpenAI-compatible endpoint (Groq / OpenRouter / self-hosted). CLOUD_PROVIDER=custom
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

LOCAL_MODEL=qwen2.5-coder:1.5b
# Keep the active local model resident between prompts. Only one model is loaded at a time:
# switching models unloads the previous one first.
LOCAL_KEEP_ALIVE=30m
# Local answer length: word budget told to the model + hard token cap ("More detail" uses DETAILED)
LOCAL_BRIEF_WORDS=200
LOCAL_BRIEF_MAX_TOKENS=1200
LOCAL_DETAILED_WORDS=800
LOCAL_DETAILED_MAX_TOKENS=4000
MIN_LOCAL_CONFIDENCE=0.7
CLOUD_CONTEXT_TOKEN_BUDGET=3000
# Cap on context sent to a cloud model. Complex/cloud tasks derive a budget from the model window
# (see cloud_catalog) up to this cap; simple local-first tasks stay small. Set =3000 to restore the
# old fixed behavior.
CLOUD_MAX_CONTEXT_TOKENS=16000
CLOUD_MODEL_CONTEXT_DEFAULT=16000

# Codebase intelligence index (compression/codeindex). Falls back to the in-memory engine on error.
CONTEXT_INDEX_ENABLED=true
# Empty = ~/.cache/localpilot/index
CONTEXT_INDEX_DIR=
# Minimum edge confidence for graph expansion (syntactic references are 0.3, below this)
CONTEXT_INDEX_MIN_CONFIDENCE=0.5
# Skip re-walking/re-hashing the repo if it synced this many seconds ago (analyze then chat).
CONTEXT_INDEX_SYNC_TTL_S=5
# Semantic retrieval (Stage 2). Fail-open: skipped when no embedding backend is available.
# Ollama: `ollama pull nomic-embed-text`; or `pip install sentence-transformers`.
CONTEXT_SEMANTIC_ENABLED=true
CONTEXT_EMBED_BACKEND=auto
CONTEXT_EMBED_MODEL=nomic-embed-text
CONTEXT_EMBED_MAX_SYMBOLS=2000
# Bounded local-model assistance (Stage 3): rerank a shortlist and propose missing names.
# Fail-open + cached; the index stays the source of truth.
CONTEXT_LLM_ASSIST=true
CONTEXT_LLM_RERANK_TOP_K=24
CONTEXT_LLM_ASSIST_TIMEOUT_S=8
CONTEXT_LLM_ASSIST_TTL_S=300
# How many times to fill/propose missing required context and re-assemble.
CONTEXT_SUFFICIENCY_MAX_ITERS=2

# --- Routing policy (see docs/routing-policy.md) ---
# Default routing preference when a request does not specify one: auto | local | cloud
DEFAULT_ROUTE=auto
# Master switch: set false to keep every request on this machine.
CLOUD_ENABLED=true
# Hard privacy policy: set true to forbid any code/prompt/history leaving the machine.
CLOUD_TRANSMISSION_PROHIBITED=false
# Post-response escalation.
ESCALATION_ENABLED=true
MAX_CLOUD_ESCALATIONS=1
# What to do when a local answer has no usable confidence: escalate | keep
MISSING_CONFIDENCE_POLICY=escalate
# Complexity score = 100 * weighted sum of task_type/context_size/files/dependency/reasoning.
# These are starting heuristics, not empirically optimal values.
COMPLEXITY_WEIGHTS={"task_type":0.25,"context_size":0.20,"files":0.20,"dependency":0.20,"reasoning":0.15}
TASK_TYPE_FLOOR=0.8
MEDIUM_TASK_FLOOR=0.75
# Zero-shot local-LLM tie-breaker for the medium band (see backend/classifier.py).
LOCAL_LLM_CLASSIFIER=true
LOCAL_LLM_CLASSIFIER_TIMEOUT_S=8
LOCAL_LLM_CLASSIFIER_TTL_S=300
# 0-100 category boundaries: simple <= 34 < medium <= 64 < complex
COMPLEXITY_SIMPLE_MAX=34
COMPLEXITY_MEDIUM_MAX=64
# Local model capability profile (override per model with LOCAL_MODEL_PROFILES).
LOCAL_MAX_CONTEXT_TOKENS=8192
LOCAL_CONTEXT_MARGIN_TOKENS=512
LOCAL_SUPPORTS_TOOL_CALLING=false
# LOCAL_MODEL_PROFILES={"qwen2.5-coder:7b":{"max_context_tokens":16384,"supports_multifile_reasoning":"yes"}}
OLLAMA_REACH_TTL_S=5
